start: "BEGIN" instruction* "END"

?instruction: put_heading
            | put_subtitle
            | put_paragraph
            | put_hyperlink
            | put_image
            | put_list
            | block_style

put_heading: "TITLE" STRING ";"
put_subtitle: "SUBTITLE" STRING ";"
put_paragraph: "TEXT" STRING ";"
put_hyperlink: "LINK" STRING STRING ";"
put_image: "IMAGE" STRING ";"
put_list: "LIST" [(ORDERED | UNORDERED)] "{" item* "}" ";"?
item: "ITEM" STRING ";"

block_style: "STYLE" IDENTIFIER "{" style_declaration* "}"
style_declaration: css_property "=" value ";"

css_property: "BG_COLOR" -> bg_color
            | "TEXT_COLOR" -> text_color
            | "FONT_SIZE" -> font_size

?value: STRING | INTEGER | HEX_COLOR | IDENTIFIER

IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/
STRING: /"[^"]*"/
INTEGER: /[0-9]+/
HEX_COLOR: /#[0-9a-fA-F]{3,6}/
ORDERED: /ORDERED/i
UNORDERED: /UNORDERED/i

%import common.WS
%import common.NEWLINE

%import common.C_COMMENT
%import common.CPP_COMMENT

%ignore WS
%ignore C_COMMENT
%ignore CPP_COMMENT